{
  "manifest_version": 3,
  "name": "ToS Risk Analizörü",
  "version": "1.0.0",
  "description": "Kullanım koşullarını ve gizlilik politikalarını yapay zeka ile analiz eder.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "options_page": "options/options.html"
}
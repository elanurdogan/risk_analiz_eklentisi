{
  "manifest_version": 3,
  "name": "ToS Risk Analizörü",
  "version": "1.0.0",
  "description": "Kullanım koşullarını ve gizlilik politikalarını yapay zeka ile analiz eder.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  }
}